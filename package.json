{
  "name": "mon-ide-claude",
  "version": "1.0.1",
  "description": "IDE local propulsé par Claude AI",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "react-start": "react-scripts start",
    "electron-start": "electron .",
    "start": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && npm run electron-start\"",
    "lint": "node -e \"const {spawnSync}=require('child_process');const r=spawnSync('npx',['eslint','src/**','--ext','.js,.jsx'],{stdio:'inherit',shell:true,env:{...process.env,ESLINT_USE_FLAT_CONFIG:'false'}});process.exit(r.status ?? 1);\"",
    "lint:fix": "node -e \"const {spawnSync}=require('child_process');const r=spawnSync('npx',['eslint','src/**','--ext','.js,.jsx','--fix'],{stdio:'inherit',shell:true,env:{...process.env,ESLINT_USE_FLAT_CONFIG:'false'}});process.exit(r.status ?? 1);\"",
    "test": "react-scripts test --env=jsdom --watchAll=false --passWithNoTests",
    "build": "react-scripts build",
    "package": "npm run clean:dist && npm run build && electron-builder build --win",
    "clean:dist": "node -e require('fs').rmSync('dist',{recursive:true,force:true})",
    "package:win": "npm run clean:dist && npm run build && electron-builder --win --x64",
    "package:win:dir": "npm run clean:dist && npm run build && electron-builder --win --x64 --dir",
    "package:win:portable": "npm run clean:dist && npm run build && electron-builder --win portable --x64"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "build": {
    "appId": "com.monide.claude",
    "productName": "Mon IDE Claude",
    "forceCodeSigning": false,
    "extraMetadata": {
      "main": "main.js"
    },
    "directories": {
      "output": "dist",
      "buildResources": "public"
    },
    "files": [
      "build/**/*",
      "main.js",
      "preload.js",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mon IDE Claude"
    }
  },
  "keywords": [],
  "author": "Moi",
  "license": "ISC",
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.4.3",
    "concurrently": "^9.1.2",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@testing-library/dom": "^10.4.1",
    "ajv": "^8.18.0",
    "node-pty": "^1.0.0",
    "openai": "^6.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-scripts": "5.0.1",
    "react-syntax-highlighter": "^16.1.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  }
}
